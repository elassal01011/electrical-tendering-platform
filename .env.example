# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Transaction Pooler used by the application at runtime.
# Example only (usually port 6543); never commit real credentials:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL=""

# Supabase Session Pooler used by Prisma migrations and seed/reset/check commands.
# Example only (usually port 5432); never commit real credentials:
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL=""

# Redis (caching / future background jobs). Not yet wired into the app code
# in this build, but docker-compose starts it and the URL is here for when
# it is.
# REDIS_URL=""

# NextAuth. Generate a real secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Optional Google OAuth (server-only credentials; never use NEXT_PUBLIC_).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Broad tendering access without user/security administration.
DEFAULT_SIGNUP_ROLE="E_SOLUTIONS_USER"
SIGNUP_REQUIRES_APPROVAL="false"

NODE_ENV="development"

# S3-compatible object storage for document uploads (Section 8 / Document
# model). Not yet wired to an upload API route in this build — see
# README "What's stubbed".
STORAGE_BUCKET="tendering-platform-documents"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Email (Section 38 notifications). Not yet wired to a send path.
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="no-reply@tendering.local"

# Optional: API key for the future AI-assisted BOQ enrichment layer
# (Section 49). The deterministic rule-based matcher in this build does
# NOT require this key — it's here only as the extension point.
AI_API_KEY=""

# BOQ workbook size policy. Browser uploads use 1 MB chunks on Vercel.
MAX_EXCEL_UPLOAD_MB="10"

# Seed/bootstrap or explicit npm run reset-admin. Password: 12–72 UTF-8 bytes.
# Seeding preserves existing passwords. See AUTH_RECOVERY.md for recovery.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Explicit opt-in for example data; leave false for business environments.
SEED_DEMO_DATA="false"
