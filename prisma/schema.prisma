// ============================================================================
// ELECTRICAL TENDERING / CPQ / PANEL ENGINEERING PLATFORM — DATABASE SCHEMA
//
// STATUS LEGEND (see README.md "What's Implemented" for details):
//   [CORE]  Fully wired to working services/API routes in this build.
//   [STUB]  Modeled for a correct DB shape and future extension, but no
//           business logic / API routes exist yet. Safe to migrate on,
//           not yet used by the app.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// AUTH / RBAC  [CORE]
// ---------------------------------------------------------------------------

enum RoleName {
  E_SOLUTIONS_USER
  SUPER_ADMIN
  GENERAL_MANAGER
  TENDERING_MANAGER
  TENDERING_ENGINEER
  ELECTRICAL_DESIGN_ENGINEER
  ESTIMATOR
  PROCUREMENT_ENGINEER
  SALES_ENGINEER
  DOCUMENT_CONTROLLER
  STORE_INVENTORY_USER
  FINANCE_USER
  CLIENT_USER
  VENDOR_USER
  CONSULTANT_USER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String?    @unique
  passwordHash String?
  image        String?
  emailVerified DateTime?
  lastLoginAt  DateTime?
  approvalPending Boolean @default(false)
  registrationMethod String @default("admin")
  sessionVersion Int @default(0)
  name         String
  active       Boolean    @default(true)
  roles        UserRole[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  assignedProjects ProjectAssignment[]
  auditLogs        AuditLog[]
  quoteRevisions   QuoteRevision[]
  notifications    Notification[]
  oauthAccounts OAuthAccount[]
}

// Identity links only. OAuth access/refresh tokens are never persisted.
model OAuthAccount {
  id String @id @default(cuid())
  userId String
  provider String
  providerAccountId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model ExcelUpload {
  id String @id @default(cuid())
  userId String
  fileName String
  mimeType String
  size Int
  expiresAt DateTime
  importedBoqId String?
  extractedData Json?
  chunks ExcelUploadChunk[]
  @@index([userId, expiresAt])
  @@index([importedBoqId])
}

model ExcelUploadChunk {
  uploadId String
  index Int
  bytes Bytes
  upload ExcelUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  @@id([uploadId, index])
}

model LoginAttempt {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}

model CompanySettings {
  id String @id @default("company")
  companyName String @default("E-SOLUTIONS")
  productName String @default("E-SOLUTIONS Tendering")
  logo String?
  email String @default("")
  phone String @default("")
  website String @default("")
  address String @default("")
  taxNumber String @default("")
  commercialRegistration String @default("")
  currency String @default("EGP")
  country String @default("Egypt")
  quotationPrefix String @default("QTN")
  minimumMarginPct Decimal @default(15) @db.Decimal(6,3)
  vatPct Decimal @default(14) @db.Decimal(6,3)
  updatedAt DateTime @updatedAt
}

model DocumentSequence {
  key String @id
  value Int @default(0)
}

model Role {
  id          String       @id @default(cuid())
  name        RoleName     @unique
  description String?
  permissions Permission[]
  users       UserRole[]
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique // e.g. "boq.import", "pricing.margin.edit"
  label String
  roles Role[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// ---------------------------------------------------------------------------
// CRM  [CORE: Client/Consultant minimal fields; CONTRACTOR/VENDOR = STUB depth]
// ---------------------------------------------------------------------------

enum PartyType {
  CLIENT
  CONSULTANT
  MAIN_CONTRACTOR
  SUBCONTRACTOR
  VENDOR
  SUPPLIER
  MANUFACTURER
}

model Party {
  id                String    @id @default(cuid())
  type              PartyType
  companyName       String
  contactName       String?
  phone             String?
  email             String?
  address           String?
  city              String?
  country           String?
  taxNumber         String?
  website           String?
  notes             String?
  preferredCurrency String?   @default("EGP")
  paymentTerms      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  projectsAsClient      Project[]              @relation("ClientParty")
  projectsAsConsultant  Project[]              @relation("ConsultantParty")
  supplierPrices        SupplierPrice[]
  boqAppliedPrices      BOQItem[]              @relation("BOQAppliedSupplier")
  supplierDiscounts     SupplierDiscount[]
  supplierRfqs          SupplierRFQ[]
  excelMappingTemplates ExcelMappingTemplate[]

  @@unique([type, companyName])
}

// ---------------------------------------------------------------------------
// PROJECT / TENDER  [CORE]
// ---------------------------------------------------------------------------

enum ProjectStatus {
  NEW
  UNDER_REVIEW
  BOQ_ANALYSIS
  ENGINEERING
  PRICING
  INTERNAL_REVIEW
  SUBMITTED
  NEGOTIATION
  WON
  LOST
  CANCELLED
}

model Project {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  clientId        String
  client          Party         @relation("ClientParty", fields: [clientId], references: [id])
  consultantId    String?
  consultant      Party?        @relation("ConsultantParty", fields: [consultantId], references: [id])
  location        String?
  country         String        @default("Egypt")
  tenderNumber    String?
  tenderDeadline  DateTime?
  currency        String        @default("EGP")
  targetMarginPct Decimal       @default(20) @db.Decimal(6, 3)
  status          ProjectStatus @default(NEW)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  assignments ProjectAssignment[]
  boqs        BOQ[]
  panels      Panel[]
  quotes      Quote[]
  documents   Document[] // [STUB] no upload pipeline yet
  revisions   ProjectRevision[]
}

model ProjectAssignment {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String // free-text role label on the project (e.g. "Lead Estimator")
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId, role])
}

model ProjectRevision {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  version   Int
  changedBy String
  reason    String?
  snapshot  Json
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// DOCUMENTS  [STUB — models only, no storage/upload service wired yet]
// ---------------------------------------------------------------------------

model Document {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  category    String
  fileName    String
  storageKey  String
  bytes Bytes?
  mimeType String @default("application/octet-stream")
  deletedAt DateTime?
  version     Int      @default(1)
  uploadedBy  String
  description String?
  createdAt   DateTime @default(now())
  @@unique([projectId, fileName, version])
}

// ---------------------------------------------------------------------------
// BOQ  [CORE — this is the load-bearing module]
// ---------------------------------------------------------------------------

model BOQ {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])
  name         String
  description  String?
  currency     String        @default("EGP")
  version      Int           @default(0)
  sourceType   String        @default("MANUAL") // MANUAL | EXCEL_IMPORT | CSV_IMPORT
  createdAt    DateTime      @default(now())
  items        BOQItem[]
  excelImports ExcelImport[]

  @@unique([projectId, name, version])
}

enum BOQItemStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  MANUAL_OVERRIDE
}

model BOQItem {
  id                      String         @id @default(cuid())
  boqId                   String
  boq                     BOQ            @relation(fields: [boqId], references: [id])
  lineNo                  Int
  originalRowNumber       Int?
  itemNumber              String?
  manufacturerRequirement String?
  modelRequirement        String?
  remarks                 String?
  isSectionHeader         Boolean        @default(false)
  rawDescription          String // original text exactly as imported, e.g.
  // "250A MCCB, 4P, 36kA, adjustable trip, Schneider"
  parsedSpec              Json? // structured output of the BOQ parser (see boqParser.ts)
  quantity                Decimal        @db.Decimal(12, 3)
  unit                    String         @default("NO")
  status                  BOQItemStatus  @default(UNMATCHED)
  matchedComponentId      String?
  matchedComponent        Component?     @relation(fields: [matchedComponentId], references: [id])
  matchScore              Decimal?       @db.Decimal(5, 2) // 0-100
  matchReason             String?
  appliedSupplierPriceId  String?
  appliedSupplierPrice    SupplierPrice? @relation(fields: [appliedSupplierPriceId], references: [id])
  appliedSupplierId       String?
  appliedSupplier         Party?         @relation("BOQAppliedSupplier", fields: [appliedSupplierId], references: [id])
  appliedUnitPrice        Decimal?       @db.Decimal(14, 2)
  appliedCurrency         String?
  priceAppliedAt          DateTime?
  priceSource             String? // SUPPLIER_PRICE | COMPONENT_LIST_PRICE | MANUAL
  createdAt               DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// CATALOG  [CORE]
// ---------------------------------------------------------------------------

enum ComponentCategory {
  MCCB
  MCB
  ACB
  RCCB
  RCBO
  CONTACTOR
  OVERLOAD_RELAY
  SWITCH_DISCONNECTOR
  FUSE
  SPD
  METER
  CT
  VFD
  SOFT_STARTER
  TERMINAL_BLOCK
  BUSBAR
  ENCLOSURE
  OTHER
}

model Component {
  id                 String            @id @default(cuid())
  manufacturer       String
  partNumber         String
  description        String
  category           ComponentCategory
  voltageV           Int?
  currentA           Decimal?          @db.Decimal(10, 2)
  poles              Int?
  breakingCapacityKA Decimal?          @db.Decimal(10, 2)
  tripUnit           String? // e.g. "Thermal-Magnetic", "Electronic LSI"
  mounting           String?
  listPrice          Decimal?          @db.Decimal(14, 2)
  listPriceCurrency  String            @default("USD")
  active             Boolean           @default(true)
  tags               String[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  boqMatches      BOQItem[]
  panelComponents PanelComponent[]
  supplierPrices  SupplierPrice[]
  accessories     ComponentAccessory[] @relation("ParentComponent")

  @@unique([manufacturer, partNumber])
}

model ExcelMappingTemplate {
  id        String   @id @default(cuid())
  name      String
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id])
  purpose   String   @default("BOQ")
  mapping   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partyId, purpose, name])
}

model ExcelImport {
  id           String   @id @default(cuid())
  boqId        String
  boq          BOQ      @relation(fields: [boqId], references: [id])
  fileName     String
  sheetName    String
  headerRow    Int
  mapping      Json
  importedRows Int
  createdBy    String
  createdAt    DateTime @default(now())
}

model ComponentAccessory {
  id                String    @id @default(cuid())
  parentComponentId String
  parent            Component @relation("ParentComponent", fields: [parentComponentId], references: [id])
  name              String
  necessity         String // REQUIRED | RECOMMENDED | OPTIONAL
}

// ---------------------------------------------------------------------------
// SUPPLIER PRICING  [CORE: SupplierPrice/Discount used by pricing engine]
// ---------------------------------------------------------------------------

model SupplierPrice {
  id                 String    @id @default(cuid())
  supplierId         String
  supplier           Party     @relation(fields: [supplierId], references: [id])
  componentId        String
  component          Component @relation(fields: [componentId], references: [id])
  price              Decimal   @db.Decimal(14, 2)
  currency           String    @default("USD")
  supplierPartNumber String?
  unit               String    @default("NO")
  source             String?
  active             Boolean   @default(true)
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  boqApplications    BOQItem[]

  @@index([componentId, effectiveFrom, effectiveTo])
  @@index([supplierId, componentId])
  @@index([supplierId, supplierPartNumber, effectiveFrom])
  @@index([active, effectiveFrom, effectiveTo])
}

model SupplierDiscount {
  id            String             @id @default(cuid())
  supplierId    String
  supplier      Party              @relation(fields: [supplierId], references: [id])
  brand         String? // matches Component.manufacturer when set
  category      ComponentCategory?
  qtyBandMin    Int                @default(0)
  qtyBandMax    Int? // null = unbounded
  discountPct   Decimal            @db.Decimal(6, 3)
  effectiveFrom DateTime           @default(now())
  effectiveTo   DateTime?

  @@unique([supplierId, brand, category, qtyBandMin])
}

// ---------------------------------------------------------------------------
// SUPPLIER RFQ  [STUB]
// ---------------------------------------------------------------------------

model SupplierRFQ {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Party    @relation(fields: [supplierId], references: [id])
  status     String   @default("SENT") // SENT|VIEWED|QUOTED|PARTIAL|REJECTED|EXPIRED
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// PANEL / BOM  [CORE]
// ---------------------------------------------------------------------------

model Panel {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  code          String // e.g. "MDB-01"
  name          String?
  panelType     String?
  ipRating      String?
  ratedVoltageV Int?
  faultLevelKA  Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sections   PanelSection[]
  components PanelComponent[]
  calcs      EngineeringCalculation[]

  @@unique([projectId, code])
}

model PanelSection {
  id      String @id @default(cuid())
  panelId String
  panel   Panel  @relation(fields: [panelId], references: [id])
  name    String // INCOMING | OUTGOING | METERING | CONTROL | SPARE ...
  order   Int    @default(0)

  components PanelComponent[]
}

model PanelComponent {
  id            String        @id @default(cuid())
  panelId       String
  panel         Panel         @relation(fields: [panelId], references: [id])
  sectionId     String?
  section       PanelSection? @relation(fields: [sectionId], references: [id])
  componentId   String
  component     Component     @relation(fields: [componentId], references: [id])
  quantity      Decimal       @default(1) @db.Decimal(12, 3)
  laborHours    Decimal       @default(0) @db.Decimal(10, 2)
  overridePrice Decimal?      @db.Decimal(14, 2) // manual override, if set
  notes         String?
}

// Preliminary engineering calculations (copper, enclosure, thermal).
// Every result is persisted with a status flag per the platform's safety rule.
enum CalcStatus {
  PRELIMINARY
  ENGINEER_VERIFIED
  APPROVED
}

model EngineeringCalculation {
  id        String     @id @default(cuid())
  panelId   String
  panel     Panel      @relation(fields: [panelId], references: [id])
  type      String // "COPPER_SIZING" | "ENCLOSURE_SIZING" | "THERMAL"
  inputs    Json
  outputs   Json
  status    CalcStatus @default(PRELIMINARY)
  createdAt DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// LABOR / OVERHEAD / MARGIN RULES  [CORE — used by pricing engine]
// ---------------------------------------------------------------------------

model LaborRate {
  id         String  @id @default(cuid())
  label      String
  hourlyRate Decimal @db.Decimal(10, 2)
  currency   String  @default("EGP")
  active     Boolean @default(true)

  @@unique([label, currency])
}

model OverheadRule {
  id          String  @id @default(cuid())
  label       String
  overheadPct Decimal @db.Decimal(6, 3)
  appliesTo   String  @default("ALL") // ALL | MATERIAL | LABOR
  active      Boolean @default(true)

  @@unique([label])
}

model MarginRule {
  id             String             @id @default(cuid())
  label          String
  category       ComponentCategory?
  markupPct      Decimal?           @db.Decimal(6, 3)
  grossMarginPct Decimal?           @db.Decimal(6, 3)
  active         Boolean            @default(true)

  @@unique([label])
}

// ---------------------------------------------------------------------------
// CURRENCY  [CORE — minimal]
// ---------------------------------------------------------------------------

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(18, 8)
  asOf          DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, asOf])
}

// ---------------------------------------------------------------------------
// QUOTE  [CORE]
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED
  SENT
  NEGOTIATION
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id])
  quoteNumber String
  revision    Int         @default(1)
  currency    String      @default("EGP")
  validUntil  DateTime?
  status      QuoteStatus @default(DRAFT)
  totalCost   Decimal?    @db.Decimal(16, 2)
  totalSell   Decimal?    @db.Decimal(16, 2)
  marginPct   Decimal?    @db.Decimal(6, 3)
  discountPct Decimal @default(0) @db.Decimal(6,3)
  vatPct Decimal @default(0) @db.Decimal(6,3)
  terms Json?
  companySnapshot Json?
  createdBy String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items     QuoteItem[]
  revisions QuoteRevision[]

  @@unique([projectId, quoteNumber, revision])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id])
  description String
  manufacturer String?
  partNumber String?
  unit String @default("NO")
  quantity    Decimal @db.Decimal(12, 3)
  unitCost    Decimal @db.Decimal(14, 2)
  unitSell    Decimal @db.Decimal(14, 2)
  lineTotal   Decimal @db.Decimal(16, 2)
}

model QuoteRevision {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id])
  changedBy String
  user      User     @relation(fields: [changedBy], references: [id])
  reason    String?
  snapshot  Json
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// TECHNICAL / COMMERCIAL OFFER  [STUB — Excel export is CORE for one type,
// full templated PDF generation is not yet implemented]
// ---------------------------------------------------------------------------

model TechnicalOffer {
  id        String   @id @default(cuid())
  quoteId   String
  fileKey   String?
  createdAt DateTime @default(now())
}

model CommercialOffer {
  id        String   @id @default(cuid())
  quoteId   String
  fileKey   String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// INVENTORY / PROCUREMENT  [STUB]
// ---------------------------------------------------------------------------

model Warehouse {
  id             String          @id @default(cuid())
  name           String
  inventoryItems InventoryItem[]
}

model InventoryItem {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  componentId String
  quantity    Decimal   @default(0) @db.Decimal(14, 3)
}

model PurchaseOrder {
  id         String   @id @default(cuid())
  supplierId String
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// AUDIT LOG / NOTIFICATIONS / SETTINGS  [CORE: AuditLog + SystemSetting]
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // e.g. "BOQ_IMPORTED", "PRICE_CHANGED", "QUOTE_APPROVED"
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemSetting {
  key   String @id
  value Json
}
